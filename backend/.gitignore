# ──────────────────────────────────────────────────────────────────────────────
# DevFlow Backend — .gitignore
# Covers: IntelliJ IDEA, Gradle, Java, macOS
# ──────────────────────────────────────────────────────────────────────────────

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*~

# ── IntelliJ IDEA ─────────────────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/
atlassian-ide-plugin.xml
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# ── Gradle ────────────────────────────────────────────────────────────────────
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
**/build/
**/!**/src/
gradle-app.setting
.gradletasknamecache

# ── Java ──────────────────────────────────────────────────────────────────────
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# ── Spring Boot ───────────────────────────────────────────────────────────────
# Exclude generated sources; never commit build artifacts
target/
*.orig

# ── Environment & Secrets ─────────────────────────────────────────────────────
# Never commit actual secret values — only templates/examples
.env
.env.*
!.env.example
*.secret
*.pem
*.key
application-local.yml
application-local.properties

# ── IDE & Editor Artifacts ────────────────────────────────────────────────────
*.suo
*.user
*.userosscache
*.sln.docstates
nbproject/
nbdist/
nb-configuration.xml
.nb-gradle/
.vscode/
.factorypath

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── Test Output ───────────────────────────────────────────────────────────────
test-results/
surefire-reports/
jacoco.exec
